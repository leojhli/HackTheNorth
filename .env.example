# Copy to .env. Do not commit credentials. Defaults require real Supabase login.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./beprogram.db
AUTH_MODE=supabase
# Optional local-only mode: AUTH_MODE=local and generate a random 32+ character token.
# Never use local auth in a hosted deployment.
LOCAL_DEV_TOKEN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
JWT_AUDIENCE=authenticated
APP_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SENTRY_DSN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SOLANA_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON array of 64 secret-key bytes for a funded DEVNET test issuer; server only.
SOLANA_ISSUER_KEY=
SOLANA_TRUSTED_ISSUERS=
COMPOSIO_API_KEY=
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
# GitHub uses fixed, allowlisted REST operations through Composio API v3.1 proxy.
