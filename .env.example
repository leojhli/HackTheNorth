# Free local edition: no API keys, accounts, subscriptions, or inference credits.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./beprogram.db
AUTH_MODE=local
# Generated by setup-local.ps1. This protects your local app; it is NOT a paid API key.
LOCAL_DEV_TOKEN=
APP_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11435
# Supported local weights: qwen2.5-coder:7b or qwen2.5-coder:3b.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CONTEXT=16384
OPERATION_TIMEOUT=120
LEASE_SECONDS=180
# Local redacted operational logs, rotating at 1 MB with three backups.
LOCAL_LOGS_ENABLED=true
LOCAL_LOG_PATH=.tools/logs/lifecycle.jsonl
# Optional Sentry free Developer account: explicit opt-in for redacted Logs + Tracing.
# No source, answers, prompts, tokens, filenames or user identity are sent.
SENTRY_ENABLED=false
SENTRY_DSN=
# Deferred: receipts are excluded from the core demo. Leave this disabled.
SOLANA_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ISSUER_KEY=
SOLANA_TRUSTED_ISSUERS=
# Legacy hosted voice and Composio settings remain disabled.
