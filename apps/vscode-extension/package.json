{
  "name": "codeproof-companion",
  "displayName": "CodeProof",
  "description": "Explain saved code changes in your VS Code sidebar and unlock the next CodeProof-managed AI request.",
  "version": "0.5.4",
  "publisher": "codeproof-local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onView:codeproof.checkpoint",
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node --check extension.cjs && node --check controller.cjs && node --check capture.cjs && node --check protocol.cjs && npm --prefix ../dashboard run build:extension",
    "test": "node --test test/unit.test.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../artifacts/codeproof-companion.vsix",
    "test:host": "node test/run-host.cjs",
    "vscode:prepublish": "npm run build && npm test"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeproof",
          "title": "CodeProof",
          "icon": "assets/codeproof.svg"
        }
      ]
    },
    "views": {
      "codeproof": [
        {
          "id": "codeproof.checkpoint",
          "name": "Checkpoint",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codeproof.open",
        "title": "CodeProof: Open checkpoint"
      },
      {
        "command": "codeproof.connect",
        "title": "CodeProof: Connect and start scoped session"
      },
      {
        "command": "codeproof.capture",
        "title": "CodeProof: Review saved changes"
      },
      {
        "command": "codeproof.ask",
        "title": "CodeProof: Managed Ask AI"
      },
      {
        "command": "codeproof.stop",
        "title": "CodeProof: End session"
      },
      {
        "command": "codeproof.refresh",
        "title": "CodeProof: Refresh saved state",
        "icon": "$(refresh)"
      },
      {
        "command": "codeproof.projects",
        "title": "CodeProof: Manage saved projects"
      },
      {
        "command": "codeproof.disconnect",
        "title": "CodeProof: Disconnect account"
      },
      {
        "command": "codeproof.history",
        "title": "CodeProof: Open learning history"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeproof.refresh",
          "when": "view == codeproof.checkpoint",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CodeProof",
      "properties": {
        "codeproof.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "scope": "machine",
          "description": "HTTPS backend origin or loopback HTTP origin. Changing it requires reconnecting."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "license": "UNLICENSED"
}
